{
  "name": "save-the-embassy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "apps/game",
    "apps/api",
    "apps/leaderboard"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w apps/leaderboard",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:python": "python -m unittest discover -s apps/game/python -p test_*.py",
    "demo": "npm run build && node apps/game/demo.mjs",
    "benchmark": "npm run build && node tools/benchmark/cli.mjs",
    "fairness": "npm run build && node tools/fairness/cli.mjs",
    "start": "node apps/api/dist/server.js",
    "test:platform": "npm run build && node --test apps/api/test/*.test.mjs",
    "load:platform": "node apps/api/test/load.mjs",
    "load:realtime": "node apps/api/test/local-stack.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0"
  }
}
